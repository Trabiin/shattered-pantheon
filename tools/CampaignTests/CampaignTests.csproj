<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for the order campaign battles open in (Unity/Assets/BattleCore/CampaignOrder.cs), on the
       real campaign data and through the game's save. See Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../../Unity/Assets/Game/Scripts/Save/*.cs" />
    <ProjectReference Include="../BattleCore/BattleCore.csproj" />
  </ItemGroup>
</Project>
